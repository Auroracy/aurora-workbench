<view class="pg fs-{{fontLevel}}">

  <!-- 顶部：一眼看清这是什么 -->
  <view class="hero card">
    <view class="hero-title">科目一 · 慢慢练</view>
    <view class="hero-sub">一天练一点，记得牢。不用赶时间，做错也不要紧。</view>
    <view class="hero-tag">按考点反复出题 · 错了下次再来</view>
  </view>

  <!-- 学习情况：三个大数字 -->
  <view class="card">
    <view class="card-title">我的学习情况</view>
    <view class="stat-row">
      <view class="stat-item">
        <view class="stat-num">{{ov.todayTotal}}</view>
        <view class="stat-label">今天做了</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{ov.rate}}<text class="stat-unit">%</text></view>
        <view class="stat-label">总正确率</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{ov.mastered}}<text class="stat-unit">/{{ov.pointTotal}}</text></view>
        <view class="stat-label">掌握考点</view>
      </view>
    </view>
    <view class="stat-foot">累计做了 {{ov.total}} 题 · 完成 {{ov.rounds}} 组 · 错题本 {{ov.wrongCount}} 题</view>
  </view>

  <!-- 三个大按钮：不用找，直接点 -->
  <button class="big-btn primary" bindtap="startPractice">开始练 10 题</button>
  <button class="big-btn outline" bindtap="startWrong">只练错题（{{ov.wrongCount}} 题）</button>
  <button class="big-btn soft" bindtap="goPoints">按考点练 · 看口诀</button>

  <!-- 字号：50 岁+ 用户最需要的开关 -->
  <view class="card font-card">
    <view class="card-title">字太小？点一下调大</view>
    <view class="font-row">
      <view class="font-btn {{fontLevel===0?'on':''}}" data-lv="0" bindtap="changeFont">标准</view>
      <view class="font-btn {{fontLevel===1?'on':''}}" data-lv="1" bindtap="changeFont">大字</view>
      <view class="font-btn {{fontLevel===2?'on':''}}" data-lv="2" bindtap="changeFont">超大字</view>
    </view>
    <view class="sub font-note">选好后，题目、选项、按钮都会一起变大。</view>
  </view>

  <!-- 最近几组练习 -->
  <view class="card" wx:if="{{history.length}}">
    <view class="card-title">最近练习</view>
    <view class="hist-row" wx:for="{{history}}" wx:key="date">
      <text class="hist-date">{{item.date}}</text>
      <text class="hist-text">{{item.text}}</text>
    </view>
  </view>

  <view class="footer-link" bindtap="clearData">清空学习记录</view>
  <view class="footer-note">真题整理自驾校一点通「小车科目一 · 专项练习」 · 口诀依据《科目一考点大字速记手册》 · 仅供个人练习</view>
</view>
