.hero { background: linear-gradient(135deg, #0F766E, #147F86); border: none; }
.hero-title { font-size: var(--fs-title); font-weight: 800; color: #FFFFFF; line-height: 1.35; }
.hero-sub { font-size: var(--fs-sub); color: #E3F4F1; margin-top: 14rpx; line-height: 1.75; }
.hero-tag {
  display: inline-block; margin-top: 22rpx; padding: 8rpx 22rpx;
  background: rgba(255,255,255,.18); color: #FFFFFF;
  border-radius: 999rpx; font-size: var(--fs-sub);
}

.stat-row { display: flex; }
.stat-item { flex: 1; text-align: center; padding: 12rpx 0 8rpx; }
.stat-num { font-size: var(--fs-num); font-weight: 800; color: var(--main); line-height: 1.15; }
.stat-unit { font-size: var(--fs-sub); font-weight: 600; color: var(--ink-2); }
.stat-label { font-size: var(--fs-sub); color: var(--ink-2); margin-top: 10rpx; }
.stat-foot {
  margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line);
  font-size: var(--fs-sub); color: var(--ink-3); text-align: center;
}

.font-card { margin-top: 8rpx; }
.font-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.font-btn {
  flex: 1; text-align: center; padding: 20rpx 0;
  border: 3rpx solid var(--line); border-radius: 20rpx;
  background: #FFFFFF; color: var(--ink-2);
  font-size: var(--fs-btn); font-weight: 700;
}
.font-btn.on { background: var(--main); border-color: var(--main); color: #FFFFFF; }
.font-note { margin-top: 4rpx; }

.hist-row {
  display: flex; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 2rpx solid var(--line);
  font-size: var(--fs-sub);
}
.hist-date { color: var(--ink-3); }
.hist-text { color: var(--ink); font-weight: 600; }

.footer-link {
  text-align: center; font-size: var(--fs-sub);
  color: var(--ink-3); padding: 16rpx; text-decoration: underline;
}
.footer-note {
  text-align: center; font-size: 26rpx; color: var(--ink-3);
  padding: 8rpx 30rpx 30rpx; line-height: 1.7;
}
