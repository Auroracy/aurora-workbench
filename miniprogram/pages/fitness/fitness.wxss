/* ===== 通用：标题行 + 超小按钮 ===== */
.card-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.card-title-row .t { font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.btn-xs { padding: 8rpx 16rpx; font-size: 22rpx; border-radius: 12rpx; }

/* ===== 今日热量 Hero ===== */
.bh-card { }
.fh-head { display: flex; align-items: center; gap: 14rpx; }
.fh-label { font-size: 26rpx; font-weight: 700; color: var(--text-2); }
.picker-inline { padding: 10rpx 22rpx; height: auto; line-height: 1.5; }

.bh-cal-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.bh-tile { flex: 0 0 auto; width: 150rpx; text-align: center; }
.bh-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; color: var(--text); font-variant-numeric: tabular-nums; }
.bh-tile.amber .bh-num { color: var(--amber); }
.bh-cap { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }

.bh-ring {
  position: relative; width: 200rpx; height: 200rpx; border-radius: 50%;
  margin: 0 auto; transition: background .35s ease;
}
.bh-ring-inner {
  position: absolute; inset: 22rpx; border-radius: 50%; background: var(--card);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: inset 0 2rpx 10rpx rgba(27, 42, 53, 0.05);
}
.bh-remain { font-size: 40rpx; font-weight: 700; color: var(--accent); line-height: 1.15; font-variant-numeric: tabular-nums; }
.bh-remain.zero { color: var(--red); }
.bh-remain-cap { font-size: 20rpx; color: var(--text-3); margin-top: 4rpx; }

.bh-macros { margin-top: 24rpx; }
.bh-macro { margin-bottom: 16rpx; }
.bh-macro:last-child { margin-bottom: 0; }
.bh-macro-head { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--text-2); margin-bottom: 8rpx; }
.bh-macro-track { height: 14rpx; border-radius: 999rpx; background: var(--line-soft); overflow: hidden; }
.bh-macro-fill { height: 100%; border-radius: 999rpx; transition: width .35s ease; }

/* ===== 体重管理方案 ===== */
.ws-goal-row { display: flex; margin-bottom: 16rpx; }
.ws-g { flex: 1; text-align: center; }
.ws-g-val { font-size: 38rpx; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; line-height: 1.2; }
.ws-g-val.down { color: var(--green); }
.ws-g-cap { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }

/* ===== 体重 ===== */
.ws-row { display: flex; align-items: center; gap: 18rpx; flex-wrap: wrap; }
.ws-item { font-size: 22rpx; color: var(--text-2); }
.ws-strong { font-size: 28rpx; font-weight: 700; color: var(--text); }
.ws-up { color: var(--amber); }
.ws-down { color: var(--green); }
.weight-chart { width: 100%; height: 176px; margin-top: 8rpx; }

/* ===== 16+8 断食 ===== */
.fast-status { font-size: 26rpx; font-weight: 500; margin: 6rpx 0 16rpx; }
.fs-label.eat { color: var(--green); }
.fs-label.fast { color: var(--accent); }
.fs-text { color: var(--text-2); }

.fast-bar {
  position: relative; height: 46rpx; border-radius: 999rpx;
  background: var(--line-soft); overflow: hidden;
}
.fast-eat {
  position: absolute; top: 0; bottom: 0;
  background: linear-gradient(90deg, #15A49B, #2E86C1);
  display: flex; align-items: center; justify-content: center;
  border-radius: 999rpx;
}
.fast-eat-label { font-size: 20rpx; color: #fff; white-space: nowrap; }
.fast-now {
  position: absolute; top: -4rpx; bottom: -4rpx; width: 4rpx;
  background: var(--red); border-radius: 2rpx;
}
.fast-axis {
  display: flex; justify-content: space-between;
  font-size: 20rpx; color: var(--text-3); margin-top: 10rpx;
}

/* ===== 表单 ===== */
.form-row { display: flex; gap: 18rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.form-group { flex: 1; min-width: 0; }
.form-group.auto { flex: 0 0 auto; }
.form-label { font-size: 24rpx; color: var(--text-2); margin-bottom: 12rpx; }
.picker {
  height: 72rpx; line-height: 72rpx; box-sizing: border-box;
  background: var(--input-bg); border: 1rpx solid var(--line);
  border-radius: 16rpx; padding: 0 22rpx; font-size: 26rpx;
}
.inp {
  height: 72rpx; box-sizing: border-box;
  background: var(--input-bg); border: 1rpx solid var(--line);
  border-radius: 16rpx; padding: 0 22rpx; font-size: 26rpx;
}
.inp-num { width: 180rpx; }

/* ===== 记录列表 ===== */
.rec-list { margin-top: 18rpx; }
.rec-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--line-soft);
}
.rec-row:last-child { border-bottom: none; }
.rec-main { flex: 1; min-width: 0; }
.rec-text { font-size: 27rpx; }
.rec-sub { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.btn-icon {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; flex: 0 0 auto;
  background: var(--input-bg); color: var(--text-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; border: 1rpx solid var(--line);
}
.btn-icon.danger { color: var(--red); }

/* ===== 食谱 ===== */
.recipe-card {
  background: var(--input-bg); border-radius: var(--radius-sm);
  padding: 24rpx;
}
.r-name { font-size: 30rpx; font-weight: 700; }
.r-cal { font-size: 26rpx; color: var(--accent); font-weight: 600; margin-top: 6rpx; }
.r-ing { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; line-height: 1.7; }
.r-desc { font-size: 22rpx; color: var(--text-3); margin-top: 10rpx; }
.recipe-nav { display: flex; gap: 16rpx; margin-top: 18rpx; }
