/* ===== Aurora 工作台 小程序 · 全局主题 =====
   沿用网页版设计语言：低饱和背景、充足留白、卡片式、青绿主色
   （尺寸换算：1px ≈ 2rpx，按 375pt 设计稿） */
page {
  --bg: #EEF3F6;
  --card: #FFFFFF;
  --text: #1B2A35;
  --text-2: #5C7484;
  --text-3: #9CB2C0;
  --accent: #15A49B;
  --accent-d: #0F8780;
  --accent-bg: #E0F4F2;
  --line: #D6E2E9;
  --line-soft: #EBF1F5;
  --input-bg: #F2F7FA;
  --green: #2DAB66;
  --green-bg: #E4F6EC;
  --amber: #D4933C;
  --amber-bg: #FAF0E0;
  --red: #DB6B6B;
  --red-bg: #FAEAEA;
  --blue: #2E86C1;
  --blue-bg: #E6F2FB;
  --radius: 26rpx;
  --radius-sm: 18rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 卡片 ===== */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(21, 164, 155, 0.06), 0 2rpx 6rpx rgba(27, 42, 53, 0.04);
}
.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title .t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.card-title .sub {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ===== 按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;   /* 关键：否则 width:100% 的整行按钮会 +padding+border 溢出卡片 */
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  line-height: 1;
  border: 1rpx solid transparent;
  transition: opacity .15s, transform .1s;
}
.btn-sm { padding: 10rpx 20rpx; font-size: 24rpx; border-radius: 14rpx; }
.btn-primary { background: var(--accent); color: #fff; font-weight: 600; }
.btn-ghost { background: var(--input-bg); color: var(--text-2); border-color: var(--line); }
.btn-line { background: #fff; color: var(--accent); border-color: var(--accent); }
.btn:active { opacity: .75; transform: scale(.98); }
.btn[disabled] { opacity: .45; }

/* ===== 小标签 ===== */
.chip {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-bg);
  color: var(--accent-d);
  line-height: 1.4;
}
.chip.gray { background: var(--input-bg); color: var(--text-2); }
.chip.green { background: var(--green-bg); color: var(--green); }
.chip.amber { background: var(--amber-bg); color: var(--amber); }
.chip.red { background: var(--red-bg); color: var(--red); }

/* ===== 区块标题 ===== */
.sec-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin: 32rpx 8rpx 16rpx;
}
.sec-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

/* ===== 统计 ===== */
.stat-row { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-label { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.stat-item.green .stat-num { color: var(--green); }
.stat-item.amber .stat-num { color: var(--amber); }
.stat-item.red .stat-num { color: var(--red); }

/* ===== 进度条 ===== */
.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line-soft);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #15A49B, #2E86C1);
  transition: width .35s ease;
}

/* ===== 空态 ===== */
.empty {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* ===== 行 ===== */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.muted { color: var(--text-3); }
.small { font-size: 22rpx; }
.divider { height: 1rpx; background: var(--line-soft); margin: 20rpx 0; }
