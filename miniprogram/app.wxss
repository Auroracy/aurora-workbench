/* ===== 科目一 · 慢慢练：适老化全局样式（50 岁+ 大字版）=====
   设计原则：字大、对比强、点击区大、层级浅、反馈明确、不用猜图标 */
page {
  --bg: #F5F7F9;
  --card: #FFFFFF;
  --ink: #16212B;
  --ink-2: #4E6070;
  --ink-3: #8293A0;
  --main: #0F766E;
  --main-d: #0A5751;
  --blue: #2E86C1;
  --ok: #177245;
  --ok-bg: #E6F5EC;
  --ok-line: #9AD6B4;
  --no: #B53025;
  --no-bg: #FDEBE8;
  --no-line: #EFB0A8;
  --tip-bg: #FFF7E5;
  --tip-line: #E9C877;
  --line: #E1E9EF;
  --shadow: 0 6rpx 24rpx rgba(22, 33, 43, .06);

  /* 三档字号：默认「大字」 */
  --fs-base: 36rpx;
  --fs-q: 48rpx;
  --fs-title: 56rpx;
  --fs-btn: 40rpx;
  --fs-opt: 40rpx;
  --fs-sub: 32rpx;
  --fs-num: 76rpx;

  background: var(--bg);
  color: var(--ink);
  font-size: var(--fs-base);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;
}

/* 字号档位：挂在页面根容器上，后代继承 */
.fs-0 { --fs-base: 32rpx; --fs-q: 42rpx; --fs-title: 48rpx; --fs-btn: 36rpx; --fs-opt: 36rpx; --fs-sub: 28rpx; --fs-num: 66rpx; }
.fs-1 { --fs-base: 36rpx; --fs-q: 48rpx; --fs-title: 56rpx; --fs-btn: 40rpx; --fs-opt: 40rpx; --fs-sub: 32rpx; --fs-num: 76rpx; }
.fs-2 { --fs-base: 42rpx; --fs-q: 56rpx; --fs-title: 64rpx; --fs-btn: 46rpx; --fs-opt: 46rpx; --fs-sub: 36rpx; --fs-num: 88rpx; }

.pg { min-height: 100vh; padding: 28rpx 24rpx 60rpx; box-sizing: border-box; }
.pg-bottom { padding-bottom: 48rpx; }

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow);
}
.card-title { font-size: var(--fs-title); font-weight: 700; color: var(--ink); margin-bottom: 20rpx; }
.sub { font-size: var(--fs-sub); color: var(--ink-2); line-height: 1.7; }
.muted { color: var(--ink-3); }

/* 大按钮：最小高度 112rpx，整行可点 */
.big-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%; min-height: 120rpx;
  border-radius: 24rpx;
  font-size: var(--fs-btn); font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  line-height: 1.3;
  padding: 20rpx 16rpx;
}
.big-btn.primary { background: var(--main); color: #FFFFFF; }
.big-btn.primary:active { background: var(--main-d); }
.big-btn.outline { background: #FFFFFF; color: var(--main); border-color: var(--main); }
.big-btn.soft { background: #EAF4F3; color: var(--main-d); }
.big-btn.blue { background: var(--blue); color: #FFFFFF; }
.big-btn.disabled { background: #DDE5EA; color: #8A9AA6; border-color: #DDE5EA; }

/* 口诀卡 */
.tip-card {
  background: var(--tip-bg);
  border: 2rpx solid var(--tip-line);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  font-size: var(--fs-sub);
  color: #6B5316;
  line-height: 1.75;
  margin-top: 24rpx;
}
.tip-label { font-weight: 700; color: #8A6410; margin-right: 12rpx; }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.gap { gap: 16rpx; }

.pill {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--fs-sub);
  background: #EAF4F3;
  color: var(--main-d);
  line-height: 1.6;
}
.pill.amber { background: #FFF2D8; color: #8A6410; }
.pill.red { background: var(--no-bg); color: var(--no); }

.empty {
  text-align: center;
  color: var(--ink-2);
  font-size: var(--fs-base);
  padding: 90rpx 30rpx;
  line-height: 2;
}
